# libpq connection string for the audit database (default: dbname=pipeline_triage_demo).
# Omitted fields fall back to PGHOST / PGPORT / PGUSER / PGPASSWORD, then libpq defaults.
PIPELINE_TRIAGE_DATABASE_DSN=dbname=pipeline_triage_demo
