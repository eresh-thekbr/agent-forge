# Optional. libpq connection string for the demo database.
# Omitted parts come from PGHOST / PGPORT / PGUSER / PGPASSWORD or libpq defaults
# (local Unix socket + your OS user). Never commit real credentials.
PIPELINE_TRIAGE_DSN=dbname=pipeline_triage_demo
# PGHOST=localhost
# PGUSER=pipeline_reader
# PGPASSWORD=change-me
